     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZNEPT_QZ_F4_TRIVIA</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00009</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Dieser Baustein ermöglicht es der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>&lt;DS:TX.DDDOK_SHLP_ELEMENTARY&gt;elementaren Suchhilfe&lt;/&gt; &lt;LS&gt;SFLIGHT&lt;/&gt;,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>die Anzahl der freien Plätze der selektierten Flüge anzuzeigen, obwohl</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>diese Anzahl in der &lt;DS:DE.SELMETHOD&gt;Selektionsmethode&lt;/&gt; &lt;LS&gt;SFLIGHTS</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>=</TDFORMAT>
       <TDLINE>&lt;/&gt; der Suchhilfe nicht als Feld enthalten ist. Vielmehr muß diese Zahl</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>aus der Anzahl der vorhandenen Sitzplätze (Feld SEATSMAX) und der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>belegten Plätze (Feld SEATSOCC) ermittelt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Dieser Baustein liest nun nach der Selektion der Treffermenge und vor</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ihrer Anzeige diese beiden Parameter aus und stellt ihre Differenz in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>den Parameter SEATSFRE.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Testen Sie die Suchhilfe SFLIGHT in der Pflegetranaktion für</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Suchhilfen, um die Wirkungsweise des Suchhilfe-Exits zu beobachten.</TDLINE>
      </TLINE>
      <TLINE/>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FURTHER_SOURCES_OF_INF&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
